# ─── Night Shift by Does News | doesnews.com ───────────────────────────────
# Documents all required Worker secrets.
# DO NOT commit real values. Set secrets via: wrangler secret put <NAME>

# Required: OpenAI API key (Responses API with web_search_preview tool)
OPENAI_API_KEY=sk-...

# Required: Tomorrow.io API key (weather forecasts — free tier works)
TOMORROW_API_KEY=...

# Required: NewsAPI.org API key (https://newsapi.org)
# Free tier: top-headlines only, 100 req/day, 15-min delay
# Developer/Business tier: /everything endpoint + real-time data (recommended)
NEWSAPI_KEY=...

# Optional: OpenAI model ID. Defaults to gpt-5.5
OPENAI_MODEL=gpt-5.5

# Optional: Host name spoken in the script. Defaults to "Penelope Rose"
HOST_NAME=Penelope Rose
